{
  "name": "@nezha/ui",
  "version": "0.1.0",
  "description": "A small, opinionated React component library in the ledger vernacular.",
  "type": "module",
  "license": "MIT",
  "author": "seonglinchua",
  "repository": {
    "type": "git",
    "url": "https://github.com/seonglinchua/nezha-ui"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "ledger"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/nezha-ui.cjs",
  "module": "./dist/nezha-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nezha-ui.js",
      "require": "./dist/nezha-ui.cjs"
    },
    "./styles.css": "./dist/nezha-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.3.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
}
